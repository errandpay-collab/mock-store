# Where the ErrandPay hosted checkout (errandpay-hosted-checkout) is running.
# Used to send shoppers to /pay/... and, server-side, to confirm payments.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# Fallback for this store's own address. The checkout page uses the address the
# store is actually served from, so this only matters if that can't be read.
NEXT_PUBLIC_STORE_URL=http://localhost:3100
