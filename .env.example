# Mock Mart is the merchant. Server-only (never NEXT_PUBLIC_):
# ErrandPay Gateway Service base URL and Mock Mart's own epKey, used by /api/pay to
# call POST /api/v1/gateway/initialize.
ERRANDPAY_BASE_URL=
ERRANDPAY_EP_KEY=

# Where the ErrandPay hosted checkout is running (shoppers are sent to /pay/{accessCode}).
NEXT_PUBLIC_GATEWAY_URL=https://staging-checkout.errandpay.com
